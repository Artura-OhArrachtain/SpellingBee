{
  "manifest_version": 3,
  "name": "SpellingBee Writing Assistant",
  "version": "1.0.0",
  "description": "Proofread selected text in online writing editors with SpellingBee.",
  "homepage_url": "https://github.com/Artura-OhArrachtain/SpellingBee",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "spellingbee-writing-assistant@spellingbee.app",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Check writing with SpellingBee",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  }
}
